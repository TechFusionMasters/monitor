<Window x:Class="SystemActivityTracker.Views.UiAMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SystemActivityTracker.Converters"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:controls="clr-namespace:SystemActivityTracker.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource AppTitle}" 
        MinHeight="600" MinWidth="800"
        Background="{StaticResource BackgroundBrush}">
    

    <Window.Resources>
        <conv:DurationTextToMinutesConverter x:Key="DurationTextToMinutesConverter"/>
        <conv:SelectedDayMaxMinutesConverter x:Key="SelectedDayMaxMinutesConverter"/>
        <conv:SelectedDayBarWidthConverter x:Key="SelectedDayBarWidthConverter"/>
        <conv:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroToVisibilityConverter"/>
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
        <conv:DecimalHoursConverter x:Key="DecimalHoursConverter"/>
        <conv:Subtract10Converter x:Key="Subtract10Converter"/>
        <conv:Subtract8Converter x:Key="Subtract8Converter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <conv:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <conv:TimelineViewModeToVisibilityConverter x:Key="TimelineViewModeToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact Header -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                Height="52" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Style="{StaticResource IconOnlyButtonStyle}"
                            ToolTip="Exit"
                            Click="ExitButton_Click"
                            Margin="0,0,8,0">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="{DynamicResource AppName}" Style="{StaticResource SubHeaderTextStyle}"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding SelectedDate, StringFormat={}{0:dd-MMM-yyyy}}"
                           Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <controls:HeaderWatchTimer/>

                    <TextBlock Text="UI:" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="UiModeComboBoxHeader" MinWidth="120" Height="30" Margin="0,0,10,0"
                              VerticalAlignment="Center" SelectionChanged="UiModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="UI A" Tag="UIA"/>
                        <ComboBoxItem Content="UI B" Tag="UIB"/>
                    </ComboBox>

                    <Border Width="74" Height="34" CornerRadius="6"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="15" Height="15" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTrackingRunning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="HeaderDot1Storyboard">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="0" To="-4" Duration="0:0:0.45" AutoReverse="True" BeginTime="0:0:0">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="HeaderDot1Storyboard"/>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <Ellipse Width="15" Height="15" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTrackingRunning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="HeaderDot2Storyboard">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="0" To="-4" Duration="0:0:0.45" AutoReverse="True" BeginTime="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="HeaderDot2Storyboard"/>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <Ellipse Width="15" Height="15">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTrackingRunning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="HeaderDot3Storyboard">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="0" To="-4" Duration="0:0:0.45" AutoReverse="True" BeginTime="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="HeaderDot3Storyboard"/>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content - Summary + Tabs -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="3*" MinWidth="600"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Summary Cards -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                <StackPanel>
                    <!-- Selected Day Card -->
                    <Border Background="White" CornerRadius="10" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1"
                            MinWidth="280" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12"/>
                        </Border.Effect>

                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Selected Day" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center"
                                           FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                <DatePicker Grid.Column="1" SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="140"/>
                            </Grid>

                            <TextBlock Text="{Binding SelectedDayLeaveSummaryText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8"
                                       Visibility="{Binding HasSelectedDayLeave, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Hidden Started/Ended Grid -->
                            <Grid Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Started:" FontSize="13" Margin="0,3,12,3" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDayStartText}" FontSize="13" Margin="0,3,0,3"
                                           HorizontalAlignment="Left"/>

                                <TextBlock Grid.Column="2" Text="Ended:" FontSize="13" Margin="20,3,12,3" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="{Binding SelectedDayEndText}" FontSize="13" Margin="0,3,0,3"
                                           HorizontalAlignment="Left"/>
                            </Grid>

                            <ContentControl Content="{Binding ActivityChartViewModel}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <controls:ActivityChart Height="195" Margin="0,12,0,0" DataContext="{Binding}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        <TextBlock Text="No data available for future dates." 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsSelectedDateInFuture, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="0,20,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Week Report Card -->
                    <Border Background="White" CornerRadius="10" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1"
                            MinWidth="280" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12"/>
                        </Border.Effect>

                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding WeekReportHeaderText}" Style="{StaticResource SectionHeaderTextStyle}"
                                           FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Command="{Binding PreviousWeekCommand}" Style="{StaticResource IconOnlyButtonStyle}"
                                            ToolTip="Previous week" Margin="0,0,4,0">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                    <Button Command="{Binding NextWeekCommand}" Style="{StaticResource IconOnlyButtonStyle}"
                                            ToolTip="Next week" Margin="0,0,4,0">
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </Button>
                                    <Button Command="{Binding CurrentWeekCommand}" Content="This Week"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="11" Margin="0,0,4,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding SelectedWeekRangeText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,8"/>

                            <TextBlock Text="{Binding WeekLeaveSummaryText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8"
                                       Visibility="{Binding HasWeekLeave, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Select week:" Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker SelectedDate="{Binding WeekPickerDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="130" ToolTip="Pick any date to jump to that week"/>
                            </StackPanel>

                            <ContentControl Content="{Binding WeeklyActivityChartViewModel}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <controls:ActivityChart Height="230" DataContext="{Binding}"/>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        <TextBlock Text="No data available for future week." 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsSelectedWeekInFuture, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="0,20,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Controls Card -->
                    <Border Background="White" CornerRadius="10" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1"
                            MinWidth="280" HorizontalAlignment="Stretch">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="Controls" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,8"
                                       FontWeight="SemiBold" FontSize="15"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 1 -->
                                <Button Grid.Row="0" Grid.Column="0" Content="Start Tracking" Command="{Binding StartCommand}" 
                                        Margin="0,0,10,6" HorizontalAlignment="Stretch" >
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrackingRunning}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource HeaderBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                        Padding="10" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Style="{StaticResource PulsingLargeStatusIndicatorStyle}"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTrackingRunning}" Value="True">
                                                            <Setter Property="Text" Value="{DynamicResource TrackingLabelRunning}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTrackingRunning}" Value="False">
                                                            <Setter Property="Text" Value="{DynamicResource TrackingLabelStopped}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    <Setter Property="Text" Value="{DynamicResource TrackingLabelUnknown}"/>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Row 2 -->
                                <Button Grid.Row="1" Grid.Column="0" Content="Stop Tracking" Command="{Binding StopCommand}" 
                                        Margin="0,0,10,0" HorizontalAlignment="Stretch">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrackingRunning}" Value="True">
                                                    <Setter Property="Background" Value="#DC2626"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTrackingRunning}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Row="1" Grid.Column="1" Content="Refresh Summary" Command="{Binding RefreshCommand}" 
                                        Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"/>
                            </Grid>

                            <!-- Developer/Test section (keep existing visual design) -->
                            <Border Style="{StaticResource TestModeCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Developer / Test" Style="{StaticResource BodyTextStyle}" 
                                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <CheckBox Content="Test mode" Style="{StaticResource UIACheckBoxStyle}" 
                                              IsChecked="{Binding IsTestMode, Mode=TwoWay}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Enables Force Write Now button" Style="{StaticResource SecondaryTextStyle}" 
                                               FontSize="11" Margin="0,0,0,8"/>
                                    <Button Content="Force Write Now" Style="{StaticResource SecondaryButtonStyle}" 
                                            Command="{Binding ForceWriteNowCommand}" IsEnabled="{Binding IsTestMode}" 
                                            HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Pane: TabControl -->
            <TabControl Grid.Column="1" Style="{StaticResource UIATabControlStyle}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                
                <!-- Monthly Usage Tab -->
                <TabItem Header="Monthly Usage" Style="{StaticResource UIATabItemStyle}">
                    <TabItem.Resources>
                    
                    <!-- Inverted Boolean to Visibility Converter (moved to Window resources) -->
                    
                    <!-- Boolean to Legend Location Converter -->
                    <conv:BooleanToLegendLocationConverter x:Key="BoolToLegendLocationConverter"/>
                    
                        <Style x:Key="WatermarkTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource UIATextBoxStyle}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <TextBlock x:Name="watermark" Text="{TemplateBinding Tag}" Margin="5,0,0,0" Foreground="Gray" Visibility="Collapsed"/>
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsFocused" Value="False"/>
                                                    <Condition Property="Text" Value=""/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="watermark" Property="Visibility" Value="Visible"/>
                                            </MultiTrigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsFocused" Value="False"/>
                                                    <Condition Property="Text" Value="{x:Null}"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="watermark" Property="Visibility" Value="Visible"/>
                                            </MultiTrigger>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="watermark" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="">
                                                <Setter TargetName="watermark" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter TargetName="watermark" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        
                        <Style x:Key="IconOnlyButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinWidth" Value="26"/>
                            <Setter Property="MinHeight" Value="26"/>
                            <Setter Property="Width" Value="26"/>
                            <Setter Property="Height" Value="26"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#11000000"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#22000000"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.35"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Calendar Day Cell Style -->
                        <Style x:Key="CalendarDayCellStyle" TargetType="Border">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="4"/>
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="Margin" Value="1"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#000000" Opacity="0.25" ShadowDepth="4" BlurRadius="8" Direction="315"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasManualTasks}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ManualTaskHighlightBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource ManualTaskHighlightBorderBrush}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasManualTasks}" Value="True"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource ManualTaskHighlightHoverBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource ManualTaskHighlightHoverBorderBrush}"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasManualTasks}" Value="False"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsWeekend}" Value="True"/>
                                        <Condition Binding="{Binding HasManualTasks}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#FFF1F2"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabItem.Resources>
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Month Selection Header -->
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="Monthly Usage" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Expected:" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,6,0" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding MonthlyExpectedText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,14,0" FontWeight="SemiBold"/>
                                        <TextBlock Text="Active:" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding MonthlyActiveText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,14,0"/>
                                        <TextBlock Text="Leave:" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding MonthlyLeaveText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,14,0"/>
                                        <TextBlock Text="Total Active:" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,6,0" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding MonthlyTotalActiveText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,14,0" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding MonthlyStatusText}" Style="{StaticResource SecondaryTextStyle}" Foreground="#059669"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Month:" Style="{StaticResource BodyTextStyle}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <controls:MonthYearPicker SelectedMonthYear="{Binding SelectedMonthYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Calendar Grid -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Weekday Headers -->
                                <UniformGrid Grid.Row="0" Columns="8" Margin="0,0,0,8">
                                    <TextBlock Text="Mon" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="Tue" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="Wed" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="Thu" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="Fri" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="Sat" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="Sun" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="Summary" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" Foreground="#10B981"/>
                                </UniformGrid>

                                <!-- Calendar Days -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding MonthlyCalendarDays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="8" Rows="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CalendarDayCellStyle}" x:Name="DayCellBorder">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.NavigateToManualTasksFromCalendarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Grid Width="132" Height="110">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Leave duration indicators (left edge overlay) -->
                                                    <Grid Grid.RowSpan="2" Width="4" HorizontalAlignment="Left" Margin="1,4,0,4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.RowSpan="2"
                                                                Background="{StaticResource LeaveIndicatorBrush}"
                                                                Visibility="{Binding HasFullDayLeave, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <Border Grid.Row="0"
                                                                Background="{StaticResource LeaveIndicatorBrush}"
                                                                Visibility="{Binding HasMorningHalfLeave, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <Border Grid.Row="1"
                                                                Background="{StaticResource LeaveIndicatorBrush}"
                                                                Visibility="{Binding HasAfternoonHalfLeave, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </Grid>

                                                    <!-- Date Number (only for regular days) -->
                                                    <TextBlock Grid.Row="0" Text="{Binding Date, StringFormat={}{0:dd}}"
                                                               FontWeight="SemiBold"
                                                               Margin="4,4,0,0"
                                                               HorizontalAlignment="Left"
                                                               Visibility="{Binding IsWeeklySummary, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                                    <!-- Week Number (only for summary cells) -->
                                                    <TextBlock Grid.Row="0" Text="{Binding WeekNumber, StringFormat=W{0}}"
                                                               FontWeight="Bold"
                                                               Margin="0,4,0,0"
                                                               HorizontalAlignment="Center"
                                                               Style="{StaticResource SecondaryTextStyle}"
                                                               Visibility="{Binding IsWeeklySummary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    
                                                    <!-- Horizontal Activity Bar / Future placeholder / Weekly Summary -->
                                                    <Grid Grid.Row="1">
                                                        <!-- Day content: Total Active text + Horizontal bar - centered vertically and horizontally -->
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                    Visibility="{Binding DataContext.IsWeeklySummary, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                            <!-- Total Active hours text - HHh MMm format, larger, centered -->
                                                            <TextBlock x:Name="TotalActiveTextBlock"
                                                                       DataContext="{Binding DataContext.HorizontalBarViewModel, RelativeSource={RelativeSource AncestorType=Border}}"
                                                                       Text="{Binding TotalActiveText}"
                                                                       FontWeight="Bold"
                                                                       FontSize="14"
                                                                       Foreground="#1F2937"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,0,0,4"
                                                                       ToolTipService.ShowDuration="30000"
                                                                       ToolTipService.InitialShowDelay="100"
                                                                       MouseLeftButtonDown="OnTotalActiveClick">
                                                                <TextBlock.ToolTip>
                                                                    <ToolTip Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="12" MaxWidth="280">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding TooltipTotalActive}" FontSize="16" FontWeight="Bold" Foreground="#1F2937" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                                            <Separator Height="1" Background="#E5E7EB" Margin="0,0,0,8"/>
                                                                            <StackPanel Margin="0,0,0,8">
                                                                                <TextBlock Text="{Binding TooltipActive}" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                                                                <TextBlock Text="{Binding TooltipManual}" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap"/>
                                                                            </StackPanel>
                                                                            <Separator Height="1" Background="#E5E7EB" Margin="0,0,0,8"/>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding TooltipIdle}" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                                                                <TextBlock Text="{Binding TooltipLocked}" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </ToolTip>
                                                                </TextBlock.ToolTip>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Setter Property="Cursor" Value="Hand"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding DataContext.IsFuture, RelativeSource={RelativeSource AncestorType=Border}}" Value="False"/>
                                                                                    <Condition Binding="{Binding DataContext.HasChart, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Horizontal Activity Bar - compact, below text, limited width -->
                                                            <controls:HorizontalActivityBar x:Name="ActivityBar"
                                                                                            DataContext="{Binding DataContext.HorizontalBarViewModel, RelativeSource={RelativeSource AncestorType=Border}}"
                                                                                            Margin="0,0,0,0"
                                                                                            Height="8"
                                                                                            Width="60"
                                                                                            VerticalAlignment="Center"
                                                                                            HorizontalAlignment="Center"
                                                                                            ToolTipService.ShowDuration="30000"
                                                                                            ToolTipService.InitialShowDelay="100"
                                                                                            MouseLeftButtonDown="OnActivityBarClick">
                                                                <controls:HorizontalActivityBar.ToolTip>
                                                                    <ToolTip Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="12" MaxWidth="280">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding TooltipTotalActive}" FontSize="16" FontWeight="Bold" Foreground="#1F2937" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                                            <Separator Height="1" Background="#E5E7EB" Margin="0,0,0,8"/>
                                                                            <StackPanel Margin="0,0,0,8">
                                                                                <TextBlock Text="{Binding TooltipActive}" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                                                                <TextBlock Text="{Binding TooltipManual}" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap"/>
                                                                            </StackPanel>
                                                                            <Separator Height="1" Background="#E5E7EB" Margin="0,0,0,8"/>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding TooltipIdle}" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                                                                <TextBlock Text="{Binding TooltipLocked}" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </ToolTip>
                                                                </controls:HorizontalActivityBar.ToolTip>
                                                                <controls:HorizontalActivityBar.Style>
                                                                    <Style TargetType="controls:HorizontalActivityBar">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Setter Property="Cursor" Value="Hand"/>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding DataContext.IsFuture, RelativeSource={RelativeSource AncestorType=Border}}" Value="False"/>
                                                                                    <Condition Binding="{Binding DataContext.HasChart, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </controls:HorizontalActivityBar.Style>
                                                            </controls:HorizontalActivityBar>
                                                        </StackPanel>

                                                        <!-- Future dates: intentionally left empty (no chart, no text) -->

                                                        <!-- Weekly summary -->
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                    Visibility="{Binding IsWeeklySummary, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding TotalActiveText}"
                                                                       FontWeight="Bold"
                                                                       Foreground="#10B981"
                                                                       Style="{StaticResource SecondaryTextStyle}"
                                                                       HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Today wave accent — 2-cycle sine strip at bottom of tile -->
                                                    <Path Grid.RowSpan="2"
                                                          VerticalAlignment="Bottom"
                                                          Width="132" Height="8"
                                                          Stretch="Fill"
                                                          Data="M 0,4 C 8,0 25,0 33,4 C 41,8 58,8 66,4 C 74,0 91,0 99,4 C 107,8 124,8 132,4 L 132,8 L 0,8 Z"
                                                          Fill="#3B82F6"
                                                          Opacity="0.30"
                                                          IsHitTestVisible="False">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Grid>
                                                </Viewbox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- Hidden Application Usage DataGrid -->
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <Grid>
                                <TextBlock Text="No data for selected month"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMonthlyUsageEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <DataGrid ItemsSource="{Binding MonthlyAppUsage}"
                                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0"
                                          CanUserSortColumns="True"
                                          IsReadOnly="True">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid" BasedOn="{StaticResource UIADataGridStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMonthlyUsageEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>

                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UIADataGridColumnHeaderStyle}"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource UIADataGridRowStyle}"/>
                                    </DataGrid.RowStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource UIADataGridCellStyle}"/>
                                    </DataGrid.CellStyle>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="App / Process" Binding="{Binding ProcessName}" Width="2*" SortMemberPath="ProcessName">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Total Active" Binding="{Binding TotalActiveText, Mode=OneWay}" Width="1*" SortMemberPath="TotalActive"/>
                                        <DataGridTextColumn Header="Total Idle" Binding="{Binding TotalIdleText, Mode=OneWay}" Width="1*" SortMemberPath="TotalIdle"/>
                                        <DataGridTextColumn Header="Total Locked" Binding="{Binding TotalLockedText, Mode=OneWay}" Width="1*" SortMemberPath="TotalLocked"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Application Usage Tab -->
                <TabItem Header="Application Usage" Style="{StaticResource UIATabItemStyle}">
                    <TabItem.Resources>
                        <Style x:Key="WatermarkTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource UIATextBoxStyle}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"/>
                                            </Border>

                                            <TextBlock x:Name="Watermark"
                                                       Text="{TemplateBinding Tag}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Opacity="0.7"
                                                       Margin="{TemplateBinding Padding}"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Visibility="Collapsed"/>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Watermark" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="IconOnlyButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinWidth" Value="26"/>
                            <Setter Property="MinHeight" Value="26"/>
                            <Setter Property="Width" Value="26"/>
                            <Setter Property="Height" Value="26"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#11000000"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#22000000"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.35"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabItem.Resources>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Application Usage" Style="{StaticResource SectionHeaderTextStyle}"/>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding TodayAppUsage}" Style="{StaticResource UIADataGridStyle}"
                                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0"
                                          CanUserSortColumns="True"
                                          IsReadOnly="True"
                                          Visibility="Collapsed">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UIADataGridColumnHeaderStyle}"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource UIADataGridRowStyle}"/>
                                    </DataGrid.RowStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource UIADataGridCellStyle}"/>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="App / Process" Binding="{Binding ProcessName}" Width="2*" SortMemberPath="ProcessName">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Active Time" Binding="{Binding ActiveDurationText, Mode=OneWay}" Width="1*" SortMemberPath="ActiveDuration"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Margin="0" Padding="6">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDayDetailsMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Manual Tasks Tab -->
                <TabItem Header="Manual Tasks" Style="{StaticResource UIATabItemStyle}">
                    <TabItem.Resources>
                        <Style x:Key="WatermarkTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource UIATextBoxStyle}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <TextBlock x:Name="watermark" Text="{TemplateBinding Tag}" Margin="5,0,0,0" Foreground="Gray" Visibility="Collapsed"/>
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsFocused" Value="False"/>
                                                    <Condition Property="Text" Value=""/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="watermark" Property="Visibility" Value="Visible"/>
                                            </MultiTrigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsFocused" Value="False"/>
                                                    <Condition Property="Text" Value="{x:Null}"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="watermark" Property="Visibility" Value="Visible"/>
                                            </MultiTrigger>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="watermark" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="">
                                                <Setter TargetName="watermark" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter TargetName="watermark" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        
                        <Style x:Key="IconOnlyButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinWidth" Value="26"/>
                            <Setter Property="MinHeight" Value="26"/>
                            <Setter Property="Width" Value="26"/>
                            <Setter Property="Height" Value="26"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#11000000"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#22000000"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.35"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabItem.Resources>
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Manual Tasks Header -->
                        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12"/>
                            </Border.Effect>

                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Manual Tasks" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center"
                                               FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                    <DatePicker Grid.Column="1" SelectedDate="{Binding ManualTasksDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="140"/>
                                </Grid>

                                <TextBox Style="{StaticResource WatermarkTextBoxStyle}" Margin="0,2,0,8" Tag="Task name"
                                         Text="{Binding ManualTaskName, UpdateSourceTrigger=PropertyChanged}"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Style="{StaticResource WatermarkTextBoxStyle}" Margin="0,0,6,0" Tag="Hours"
                                             Text="{Binding ManualHours, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource WatermarkTextBoxStyle}" Margin="0,0,6,0" Tag="Minutes"
                                             Text="{Binding ManualMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource WatermarkTextBoxStyle}" Tag="Seconds"
                                             Text="{Binding ManualSeconds, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Button Grid.Column="3" Margin="6,0,0,0" Style="{StaticResource IconOnlyButtonStyle}"
                                            Command="{Binding PrimaryManualTaskCommand}" ToolTip="Add / Save">
                                        <TextBlock Text="{Binding PrimaryManualTaskGlyph}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Grid.Column="4" Margin="6,0,0,0" Style="{StaticResource IconOnlyButtonStyle}"
                                            Command="{Binding CancelManualTaskEditCommand}" ToolTip="Cancel"
                                            Visibility="{Binding IsManualEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>

                                <TextBlock Text="Tip: Values auto-normalize (e.g., 90 seconds becomes 1m 30s)." Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8"/>
                            </StackPanel>
                        </Border>

                        <!-- Timeline View Selector and Navigation -->
                        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- View Mode Selector -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <RadioButton Content="Date" IsChecked="{Binding TimelineViewMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Date}" Margin="0,0,12,0"/>
                                    <RadioButton Content="Week" IsChecked="{Binding TimelineViewMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Week}" Margin="0,0,12,0"/>
                                    <RadioButton Content="Month" IsChecked="{Binding TimelineViewMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Month}"/>
                                </StackPanel>

                                <!-- Navigation Bar with Dynamic Pickers -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Command="{Binding NavigatePreviousCommand}" Style="{StaticResource IconOnlyButtonStyle}" Margin="0,0,8,0" ToolTip="Previous">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                    </Button>
                                    
                                    <!-- Date Picker for Date view -->
                                    <DatePicker SelectedDate="{Binding TimelineCurrentDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                Width="140" Margin="0,0,8,0" VerticalAlignment="Center"
                                                Visibility="{Binding TimelineViewMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Date}"/>
                                    
                                    <!-- Date Picker for Week view (select any day in week) -->
                                    <DatePicker SelectedDate="{Binding TimelineCurrentDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                Width="140" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Select any day in the week"
                                                Visibility="{Binding TimelineViewMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Week}"/>
                                    
                                    <!-- Month + Year Pickers for Month view -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center"
                                                Visibility="{Binding TimelineViewMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Month}">
                                        <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" 
                                                  Width="100" Margin="0,0,6,0"/>
                                        <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" 
                                                  Width="70"/>
                                    </StackPanel>
                                    
                                    <!-- Period Label (shown for Week view) -->
                                    <TextBlock Text="{Binding PeriodLabelFormatted}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" MinWidth="140" TextAlignment="Center"
                                               Visibility="{Binding TimelineViewMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Week}"/>
                                    
                                    <Button Command="{Binding NavigateNextCommand}" Style="{StaticResource IconOnlyButtonStyle}" ToolTip="Next">
                                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Manual Tasks Content (Timeline or DataGrid) -->
                        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="12" BorderBrush="#E5E7EB" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12"/>
                            </Border.Effect>

                            <Grid>
                                <!-- Date Mode: Original DataGrid -->
                                <DataGrid ItemsSource="{Binding ManualTasks}" SelectedItem="{Binding SelectedManualTask, Mode=TwoWay}"
                                          Style="{StaticResource UIADataGridStyle}"
                                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          CanUserSortColumns="True" IsReadOnly="True"
                                          Visibility="{Binding TimelineViewMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Date}">
                                <DataGrid.RowHeight>40</DataGrid.RowHeight>
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UIADataGridColumnHeaderStyle}"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource UIADataGridRowStyle}"/>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource UIADataGridCellStyle}"/>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="72" MinWidth="72" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Margin="2,0" CommandParameter="{Binding}" Focusable="False">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconOnlyButtonStyle}">
                                                            <Setter Property="ToolTip" Value="Edit"/>
                                                            <Setter Property="Command" Value="{Binding DataContext.BeginEditManualTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsManualEditMode, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                                                                    <Setter Property="Command" Value="{Binding DataContext.CancelManualTaskEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                                                    <Setter Property="CommandParameter" Value="{x:Null}"/>
                                                                    <Setter Property="ToolTip" Value="Cancel"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="{Binding DataContext.ManualRowActionGlyph, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="18"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="72" MinWidth="72" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Margin="2,0" CommandParameter="{Binding}" ToolTip="Delete" Focusable="False" PreviewMouseLeftButtonDown="DeleteButton_PreviewMouseLeftButtonDown">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconOnlyButtonStyle}"/>
                                                    </Button.Style>
                                                    <TextBlock Text="{Binding DataContext.ManualDeleteGlyph, RelativeSource={RelativeSource AncestorType=DataGrid}}" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Task Name" Binding="{Binding TaskName}" Width="2*" SortMemberPath="TaskName">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationText, Mode=OneWay}" Width="1*" SortMemberPath="TotalSeconds"/>
                                </DataGrid.Columns>
                            </DataGrid>

                                <!-- Week/Month Mode: Timeline ItemsControl -->
                            <ItemsControl ItemsSource="{Binding TimelineItems}" 
                                          Visibility="{Binding TimelineViewMode, Converter={StaticResource TimelineViewModeToVisibilityConverter}}"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.Template>
                                    <ControlTemplate>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Date Group -->
                                        <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <!-- Date Header -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Date, StringFormat='{}{0:ddd, MMM d}'}" 
                                                               FontWeight="SemiBold" FontSize="14" Foreground="#374151"/>
                                                    <TextBlock Text=" - " Foreground="#9CA3AF" Margin="4,0"/>
                                                    <TextBlock Text="{Binding TotalDurationText}" 
                                                               FontWeight="SemiBold" FontSize="14" Foreground="#059669"/>
                                                </StackPanel>
                                                
                                                <!-- Task Rows -->
                                                <ItemsControl ItemsSource="{Binding Tasks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F9FAFB" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    
                                                                    <TextBlock Grid.Column="0" Text="{Binding TaskName}" 
                                                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding DurationText}" 
                                                                               Foreground="#6B7280" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                                    <Button Grid.Column="2" Style="{StaticResource IconOnlyButtonStyle}" 
                                                                            Command="{Binding DataContext.BeginEditManualTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Margin="8,0,0,0" ToolTip="Edit" Focusable="False">
                                                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                                    </Button>
                                                                    <Button Grid.Column="3" Style="{StaticResource IconOnlyButtonStyle}" 
                                                                            CommandParameter="{Binding}" Margin="4,0,0,0" ToolTip="Delete" Focusable="False"
                                                                            PreviewMouseLeftButtonDown="DeleteButton_PreviewMouseLeftButtonDown">
                                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                                <!-- Empty State for Date Mode -->
                                <TextBlock Text="No manual tasks for this date" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#9CA3AF" FontSize="14"
                                           Visibility="{Binding ShowDateViewEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Empty State for Week/Month Mode -->
                                <TextBlock Text="No manual tasks for this period" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#9CA3AF" FontSize="14"
                                           Visibility="{Binding ShowTimelineViewEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Leaves Tab -->
                <TabItem Header="Leaves" Style="{StaticResource UIATabItemStyle}">
                    <TabItem.Resources>
                        <Style x:Key="LeaveCalendarDayCellStyle" TargetType="Border">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="4"/>
                            <Setter Property="Padding" Value="6"/>
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="MinHeight" Value="72"/>
                            <Setter Property="MinWidth" Value="90"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLeave}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource LeaveCalendarHighlightBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource LeaveCalendarHighlightBorderBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TabItem.Resources>
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Month navigation -->
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Leaves" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Command="{Binding NavigateLeavePreviousMonthCommand}" Style="{StaticResource IconOnlyButtonStyle}" Margin="0,0,8,0" ToolTip="Previous month">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                    </Button>
                                    <controls:MonthYearPicker SelectedMonthYear="{Binding LeaveSelectedMonthYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                    <Button Command="{Binding NavigateLeaveNextMonthCommand}" Style="{StaticResource IconOnlyButtonStyle}" ToolTip="Next month">
                                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Leave entry form -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Date" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding LeaveFormDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="Duration" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding LeaveDurationChoices}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding LeaveFormDuration, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock Text="Type" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding LeaveTypeChoices}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding LeaveFormType, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Style="{StaticResource IconOnlyButtonStyle}" Command="{Binding SaveLeaveCommand}" ToolTip="{Binding LeaveFormPrimaryTooltip}" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding LeaveFormPrimaryGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                                    </Button>
                                    <Button Style="{StaticResource IconOnlyButtonStyle}" Command="{Binding DeleteLeaveCommand}" ToolTip="Delete" Margin="0,0,6,0">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                                    </Button>
                                    <Button Style="{StaticResource IconOnlyButtonStyle}" Command="{Binding CancelLeaveEditCommand}" ToolTip="Cancel"
                                            Visibility="{Binding IsLeaveEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Leaves calendar -->
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <UniformGrid Grid.Row="0" Columns="7" Margin="0,0,0,8">
                                    <TextBlock Text="Mon" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="Tue" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="Wed" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="Thu" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="Fri" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="Sat" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="Sun" HorizontalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}"/>
                                </UniformGrid>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding LeaveCalendarDays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource LeaveCalendarDayCellStyle}">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectLeaveCalendarDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Date, StringFormat={}{0:dd}}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                                    <TextBlock Text="{Binding LeaveSummaryText}" Style="{StaticResource SecondaryTextStyle}" FontSize="11"
                                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding HasLeave, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Weekly Overview Tab -->
                <TabItem Header="Weekly Overview" Style="{StaticResource UIATabItemStyle}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Weekly Overview Header -->
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Weekly Overview" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center"/>
                                
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding PreviousWeekCommand}" Style="{StaticResource IconOnlyButtonStyle}"
                                            ToolTip="Previous week" Margin="0,0,6,0">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                    </Button>
                                    <Button Command="{Binding NextWeekCommand}" Style="{StaticResource IconOnlyButtonStyle}"
                                            ToolTip="Next week" Margin="0,0,6,0">
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                    </Button>
                                    <TextBlock Text="{Binding SelectedWeekRangeText}" Style="{StaticResource SecondaryTextStyle}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Command="{Binding CurrentWeekCommand}" Content="This Week"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Select week:" Style="{StaticResource BodyTextStyle}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <DatePicker SelectedDate="{Binding WeekPickerDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="140" ToolTip="Pick any date to jump to that week"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Weekly Overview DataGrid -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <DataGrid ItemsSource="{Binding WeeklySummaries}" Style="{StaticResource UIADataGridStyle}"
                                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      CanUserSortColumns="True"
                                      IsReadOnly="True">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UIADataGridColumnHeaderStyle}"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource UIADataGridRowStyle}"/>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource UIADataGridCellStyle}"/>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, Mode=OneWay, StringFormat={}{0:dd-MMM-yyyy}}" Width="1*" SortMemberPath="Date"/>
                                    <DataGridTextColumn Header="Locked" Binding="{Binding LockedDurationText, Mode=OneWay}" Width="1*" SortMemberPath="LockedDuration"/>
                                    <DataGridTextColumn Header="Idle" Binding="{Binding IdleDurationText, Mode=OneWay}" Width="1*" SortMemberPath="IdleDuration"/>
                                    <!-- Active, Manual, Total Active: grouped as sub-table with border and highlight -->
                                    <DataGridTextColumn Header="Active" Binding="{Binding ActiveDurationText, Mode=OneWay}" Width="1*" SortMemberPath="ActiveDuration">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UIADataGridColumnHeaderStyle}">
                                                <Setter Property="Background" Value="#E0F2E9"/>
                                                <Setter Property="BorderBrush" Value="#2E7D5A"/>
                                                <Setter Property="BorderThickness" Value="2,1,1,1"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource UIADataGridCellStyle}">
                                                <Setter Property="Background" Value="#E8F5EB"/>
                                                <Setter Property="BorderBrush" Value="#2E7D5A"/>
                                                <Setter Property="BorderThickness" Value="2,0,1,0"/>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Manual" Binding="{Binding ManualTaskDurationText, Mode=OneWay}" Width="1*" SortMemberPath="ManualTaskDuration">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UIADataGridColumnHeaderStyle}">
                                                <Setter Property="Background" Value="#E0F2E9"/>
                                                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                <Setter Property="BorderBrush" Value="#A5D6A7"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource UIADataGridCellStyle}">
                                                <Setter Property="Background" Value="#E8F5EB"/>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Leave" Binding="{Binding LeaveCreditText, Mode=OneWay}" Width="1*" SortMemberPath="LeaveCredit">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UIADataGridColumnHeaderStyle}">
                                                <Setter Property="Background" Value="#E0F2E9"/>
                                                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                <Setter Property="BorderBrush" Value="#A5D6A7"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource UIADataGridCellStyle}">
                                                <Setter Property="Background" Value="#E8F5EB"/>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total Active" Binding="{Binding TotalActiveDurationText, Mode=OneWay}" Width="1*" SortMemberPath="TotalActiveDuration">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource UIADataGridColumnHeaderStyle}">
                                                <Setter Property="Background" Value="#E0F2E9"/>
                                                <Setter Property="BorderBrush" Value="#2E7D5A"/>
                                                <Setter Property="BorderThickness" Value="0,1,2,1"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource UIADataGridCellStyle}">
                                                <Setter Property="Background" Value="#E8F5EB"/>
                                                <Setter Property="BorderBrush" Value="#2E7D5A"/>
                                                <Setter Property="BorderThickness" Value="0,0,2,0"/>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Weekly Totals -->
                        <Grid Grid.Row="2" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#6B7280" CornerRadius="6,0,0,6"/>
                                    <StackPanel Grid.Column="1" Margin="12,10" VerticalAlignment="Center">
                                        <TextBlock Text="Expected" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding WeekExpectedHoursText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#2563EB" CornerRadius="6,0,0,6"/>
                                    <StackPanel Grid.Column="1" Margin="12,10" VerticalAlignment="Center">
                                        <TextBlock Text="Active" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding WeekActiveText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#F59E0B" CornerRadius="6,0,0,6"/>
                                    <StackPanel Grid.Column="1" Margin="12,10" VerticalAlignment="Center">
                                        <TextBlock Text="Leave" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding WeekLeaveHoursText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SuccessBrush}" CornerRadius="6,0,0,6"/>
                                    <StackPanel Grid.Column="1" Margin="12,10" VerticalAlignment="Center">
                                        <TextBlock Text="Total Active" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding WeekTotalActiveText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding WeekStatusText}" FontSize="11" Foreground="#059669" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="8" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource BorderBrush}" CornerRadius="6,0,0,6"/>
                                    <StackPanel Grid.Column="1" Margin="12,10" VerticalAlignment="Center">
                                        <TextBlock Text="Idle" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding WeeklyTotalIdleText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Last Crash Tab -->
                <TabItem Header="Last Crash" Style="{StaticResource UIATabItemStyle}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    <TextBlock Text="{Binding LastCrash.CrashSummary}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding LastCrash.CrashLogPath}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                            Command="{Binding LastCrash.RefreshCommand}"/>
                                    <Button Content="Open Log" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding LastCrash.OpenLogCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <Grid>
                                <TextBlock Text="No crash data found."
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastCrash.HasCrashData}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastCrash.HasCrashData}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>

                                    <TextBox Text="{Binding LastCrash.CrashDetailsText, Mode=OneWay}" IsReadOnly="True"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                             FontFamily="Consolas" FontSize="12" Padding="12"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Settings Tab -->
                <TabItem Header="Settings" Style="{StaticResource UIATabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                        <StackPanel>

                            <!-- Settings Card -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Settings" Style="{StaticResource SectionHeaderTextStyle}"/>
                                    
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Text="UI:" Style="{StaticResource BodyTextStyle}" 
                                                   VerticalAlignment="Center" Margin="0,0,8,0" Width="80"/>
                                        <ComboBox x:Name="UiModeComboBox" Grid.Column="1" MinWidth="140" SelectionChanged="UiModeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="UI A" Tag="UIA"/>
                                            <ComboBoxItem Content="UI B" Tag="UIB"/>
                                        </ComboBox>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Text="Idle (min):" Style="{StaticResource BodyTextStyle}" 
                                                   VerticalAlignment="Center" Margin="0,0,8,0" Width="80"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource UIATextBoxStyle}" Margin="0,0,0,6"
                                                 Text="{Binding IdleThresholdMinutes, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,10"
                                                   Text="Marks you as idle after this many minutes without keyboard/mouse input."/>
                                        
                                        <TextBlock Grid.Row="2" Text="Poll (sec):" Style="{StaticResource BodyTextStyle}" 
                                                   VerticalAlignment="Center" Margin="0,0,8,0" Width="80"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource UIATextBoxStyle}" Margin="0,0,0,6"
                                                 Text="{Binding PollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,10"
                                                   Text="How often tracking checks the active window / idle state (lower = more frequent)."/>
                                        
                                        <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="Enable live refresh" 
                                                  Style="{StaticResource UIACheckBoxStyle}" Margin="0,0,0,6"
                                                  IsChecked="{Binding EnableLiveRefresh, Mode=TwoWay}"/>

                                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,10"
                                                   Text="Automatically refreshes the summary while tracking is running and the selected date is today."/>
                                        
                                        <TextBlock Grid.Row="6" Text="Refresh (sec):" Style="{StaticResource BodyTextStyle}" 
                                                   VerticalAlignment="Center" Margin="0,0,8,0" Width="80"/>
                                        <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource UIATextBoxStyle}" Margin="0,0,0,6"
                                                 Text="{Binding LiveRefreshIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,12"
                                                   Text="Interval for live refresh. Applied after clicking Save Settings."/>

                                        <TextBlock Grid.Row="8" Text="Crash retention (days):" Style="{StaticResource BodyTextStyle}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" Width="140"/>
                                        <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource UIATextBoxStyle}" Margin="0,0,0,6"
                                                 Text="{Binding CrashLogRetentionDays, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Grid.Row="9" Text="Crash max size (MB):" Style="{StaticResource BodyTextStyle}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" Width="140"/>
                                        <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource UIATextBoxStyle}" Margin="0,0,0,6"
                                                 Text="{Binding CrashLogMaxSizeMB, UpdateSourceTrigger=PropertyChanged}"/>

                                        <Button Grid.Row="10" Grid.ColumnSpan="2" Content="Clear crash logs"
                                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                                Command="{Binding ClearCrashLogsCommand}"/>
                                        
                                        <Button Grid.Row="11" Grid.ColumnSpan="2" Content="Save Settings" 
                                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"
                                                Command="{Binding SaveSettingsCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
